{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build using Unix generator",
      "generator": "Unix Makefiles",
      "environment": {
        "CMAKE_PREFIX_PATH": "$penv{CMAKE_PREFIX_PATH}:$penv{HOME}/Desktop/ros_motion/install:$penv{HOME}/.vcpkg-clion/vcpkg/installed/arm64-osx/share"
      },
      "cacheVariables": {
        "BUILD_WITH_HPP_FCL_SUPPORT": {
          "type": "BOOL",
          "value": "ON"
        },
        "BUILD_PYTHON_INTERFACE": {
          "type": "BOOL",
          "value": "OFF"
        },
        "BUILD_TESTING": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    }
  ]
}